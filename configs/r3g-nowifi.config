# FanchmWrt 25.12.6 - Xiaomi Mi Router 3G（非 v2 / NAND 128MB）无 WiFi
# 目标：ramips / mt7621 / xiaomi_mi-router-3g
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3g=y

# FanchmWrt 默认主题 luci-theme-fanchmwrt 依赖中文语言支持
CONFIG_LUCI_LANG_zh_Hans=y

# 双保险：即使源码补丁未生效，也不打包无线驱动与无线守护进程
# CONFIG_PACKAGE_kmod-mt7603 is not set
# CONFIG_PACKAGE_kmod-mt76x2 is not set
# CONFIG_PACKAGE_kmod-mt76-core is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# 无 WiFi 硬件时无意义的无线管理界面
# CONFIG_PACKAGE_luci-app-fwx-wireless is not set